# What the two RTSP streams carry (0x11). The MT11 accepts these combinations:
#   main ZOOM          + sub THERMAL
#   main THERMAL       + sub ZOOM
#   main ZOOM_THERMAL  + sub THERMAL
uint8 ZOOM = 0
uint8 WIDE = 1
uint8 THERMAL = 2
uint8 ZOOM_THERMAL = 3
uint8 main_stream   # rtsp://<ip>:8554/video1
uint8 sub_stream    # rtsp://<ip>:8554/video2
---
bool success
uint8 main_stream   # what the pod reports now
uint8 sub_stream
string message
