# Thermal camera settings.
uint8 SET_PALETTE = 0       # value: palette, GimbalStatus.PALETTE_*
uint8 SET_GAIN = 1          # value: 0 low gain (hot scenes), 1 high gain (better contrast)
uint8 REFRESH_SHUTTER = 2   # flat-field correction now (value unused)
uint8 command
uint8 value
---
bool success
uint8 value     # what the camera reports now
string message
